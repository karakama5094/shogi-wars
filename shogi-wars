/**
 * 将棋ウォーズ風 CP対戦将棋アプリ
 * 形勢評価計算・形勢判定ロジック & USIエンジン通信ハンドラー
 */

// ==========================================
// 1. 型定義
// ==========================================

export type PlayerSide = 'SENTE' | 'GOTE'; // 先手(自分) | 後手(CP)

export type EvaluationPhase = 'EQUAL' | 'ADVANTAGE' | 'DISADVANTAGE' | 'WINNING' | 'LOSING';

export interface PhaseInfo {
  phase: EvaluationPhase;
  label: '互角' | '優勢' | '劣勢' | '勝勢' | '敗勢';
  colorHex: string;
  isFavorable: boolean; // プレイヤー(先手)視点で有利かどうか
}

export interface EvaluationState {
  rawScoreCp: number;      // 評価値 (Centipawns: 例 +150, -72)
  isMate: boolean;          // 詰み検出フラグ
  mateInMoves?: number;     // 詰み手数 (正: 先手勝ち, 負: 後手勝ち)
  winRate: number;          // プレイヤー視点の勝率 (0.0 〜 1.0)
  phaseInfo: PhaseInfo;     // 5段階判定ラベル
  pvMoves: string[];        // 読み筋 (Principal Variation)
  depth: number;            // 探索深さ
  nodes: number;            // 探索ノード数
}

export interface MoveRecord {
  moveNumber: number;       // 手数 (1〜)
  side: PlayerSide;         // 手番
  notation: string;         // 指し手表記 (例: "▲７六歩")
  evalState: EvaluationState;
  timestamp: number;
}

export interface AILevelSpec {
  level: number;
  name: string;
  rankName: string;         // 例: "九段", "初段"
  rating: number;           // 推定レーティング
  depthLimit: number;       // 探索深さ上限
  nodesLimit?: number;      // 探索ノード数上限
  randomMistakeRate: number;// 緩み手の発生確率 (0.0 〜 1.0)
  usiOptions: Record<string, string | number | boolean>;
}

