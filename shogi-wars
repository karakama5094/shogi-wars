          <span class="level-item-badge">レート 1600</span>
        </div>
      </div>
      <button class="modal-close-btn" id="closeLevelModalBtn">決定して戻る</button>
    </div>
  </div>
</div>

<script>
  // 初期対局サンプル局面（矢倉戦法の進行サンプル）
  // 9x9マスの標準初期配置とサンプルの駒データ
  const initialBoard = [
    ["香", "桂", "銀", "金", "王", "金", "銀", "桂", "香"],
    ["", "飛", "", "", "", "", "", "角", ""],
    ["歩", "歩", "歩", "歩", "歩", "歩", "歩", "歩", "歩"],
    ["", "", "", "", "", "", "", "", ""],
    ["", "", "", "", "", "", "", "", ""],
    ["", "", "", "", "", "", "", "", ""],
    ["歩", "歩", "歩", "歩", "歩", "歩", "歩", "歩", "歩"],
    ["", "角", "", "", "", "", "", "飛", ""],
    ["香", "桂", "銀", "金", "玉", "金", "銀", "桂", "香"]
  ];

  // 評価値推移の模擬サンプルデータ（手数ごとの評価値 cp）
  const sampleMatchHistory = [
    { move: 1, notation: "▲７六歩", eval: 35 },
    { move: 2, notation: "△３四歩", eval: 20 },
    { move: 3, notation: "▲２六歩", eval: 45 },
    { move: 4, notation: "△８四歩", eval: 30 },
    { move: 5, notation: "▲２五歩", eval: 60 },
    { move: 6, notation: "△８五歩", eval: 50 },
    { move: 7, notation: "▲７八金", eval: 75 },
    { move: 8, notation: "△３二金", eval: 65 },
    { move: 9, notation: "▲２四歩", eval: 90 },
    { move: 10, notation: "△同　歩", eval: 80 },
    { move: 11, notation: "▲同　飛", eval: 95 },
    { move: 12, notation: "△８六歩", eval: 85 },
    { move: 13, notation: "▲同　歩", eval: 90 },
    { move: 14, notation: "△同　飛", eval: 70 },
    { move: 15, notation: "▲３四飛", eval: 120 },
    { move: 16, notation: "△３三銀", eval: -40 },
    { move: 17, notation: "▲３六飛", eval: 65 },
    { move: 18, notation: "△８四飛", eval: 80 },
    { move: 19, notation: "▲２六飛", eval: 110 },
    { move: 20, notation: "△２二歩", eval: 130 },
    { move: 21, notation: "▲６八銀", eval: 125 },
    { move: 22, notation: "△６二銀", eval: 140 },
    { move: 23, notation: "▲４八玉", eval: 115 },
    { move: 24, notation: "△４二玉", eval: 105 },
    { move: 25, notation: "▲３八玉", eval: 140 },
    { move: 26, notation: "△５二金", eval: 135 },
    { move: 27, notation: "▲７七銀", eval: 150 },
    { move: 28, notation: "△７四歩", eval: 120 },
    { move: 29, notation: "▲８八銀", eval: 90 },
    { move: 30, notation: "△７三桂", eval: 80 },
    { move: 31, notation: "▲８七金", eval: 110 },
    { move: 32, notation: "△８一飛", eval: 95 },
    { move: 33, notation: "▲６六歩", eval: 130 },
    { move: 34, notation: "△６四歩", eval: 120 },
    { move: 35, notation: "▲５八金", eval: 145 },
    { move: 36, notation: "△６三銀", eval: 135 },
    { move: 37, notation: "▲９六歩", eval: 160 },
    { move: 38, notation: "△９四歩", eval: 155 },
    { move: 39, notation: "▲１六歩", eval: 180 },
    { move: 40, notation: "△１四歩", eval: 170 },
    { move: 41, notation: "▲２八銀", eval: 210 },
    { move: 42, notation: "△５四歩", eval: 195 },
    { move: 43, notation: "▲３六歩", eval: 230 },
    { move: 44, notation: "△４四歩", eval: 180 },
    { move: 45, notation: "▲３七桂", eval: 240 },
    { move: 46, notation: "△４三金右", eval: 190 },
    { move: 47, notation: "▲４六歩", eval: 320 } // 47手目: 優勢
  ];

  let currentMoveIndex = sampleMatchHistory.length - 1;

  // 盤面構築
  const boardEl = document.getElementById("shogiBoard");
  function renderBoard() {
    boardEl.innerHTML = "";
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const cell = document.createElement("div");
        cell.className = "board-cell";
        cell.dataset.row = r;
        cell.dataset.col = c;

        // 星（4隅の点） (2,2), (2,6), (6,2), (6,6)
        if ((r === 2 || r === 5) && (c === 2 || c === 5)) {
          const star = document.createElement("div");
          star.className = "star-dot";
          star.style.bottom = "-2.5px";
          star.style.right = "-2.5px";
          cell.appendChild(star);
        }

        const pieceChar = initialBoard[r][c];
        if (pieceChar) {
          const piece = document.createElement("div");
          piece.className = "piece";
          if (r < 3) piece.classList.add("gote");
          piece.textContent = pieceChar;
          cell.appendChild(piece);
        }

        // サンプル着手ハイライト
        if (r === 5 && c === 5) {
          cell.classList.add("last-move-cell");
        }

        cell.addEventListener("click", () => {
          document.querySelectorAll(".board-cell").forEach(el => el.classList.remove("selected-cell"));
          cell.classList.add("selected-cell");
        });

        boardEl.appendChild(cell);
      }
    }
  }

  // 評価値から勝率へのシグモイド変換（将棋GUI標準: 定数600）
  function calculateWinRate(evalCp) {
    return 1 / (1 + Math.pow(10, -evalCp / 600));
  }

  // 5段階形勢判定ロジック
  function getPhaseStatus(evalCp) {
    if (evalCp >= 1000) {
      return { label: "勝勢", class: "winning", code: "WINNING" };
    } else if (evalCp > 300) {
      return { label: "優勢", class: "advantage", code: "ADVANTAGE" };
    } else if (evalCp >= -300) {
      return { label: "互角", class: "equal", code: "EQUAL" };
    } else if (evalCp >= -1000) {
      return { label: "劣勢", class: "disadvantage", code: "DISADVANTAGE" };
    } else {
      return { label: "敗勢", class: "losing", code: "LOSING" };
    }
  }

  // 評価バーとグラフの更新
  function updateEvaluationUI() {
    const currentData = sampleMatchHistory[currentMoveIndex];
    const evalCp = currentData.eval;
    const winRate = calculateWinRate(evalCp);
    const playerPercent = (winRate * 100).toFixed(1);
    const cpPercent = (100 - playerPercent).toFixed(1);

    const phase = getPhaseStatus(evalCp);

    // テキスト更新
    const scoreTextEl = document.getElementById("evalScoreText");
    scoreTextEl.textContent = (evalCp > 0 ? "+" : "") + evalCp;
    scoreTextEl.className = "score-value " + (evalCp >= 0 ? "positive" : "negative");

    const badgeEl = document.getElementById("evalPhaseBadge");
    badgeEl.textContent = phase.label;
    badgeEl.className = "phase-badge " + phase.class;

    const winRateTextEl = document.getElementById("winRateText");
    winRateTextEl.innerHTML = `勝率: <b style="color:${evalCp >= 0 ? '#64b5f6' : '#ef9a9a'}">${playerPercent}%</b> (あなた)`;

    // バー幅更新
    document.getElementById("playerBarFill").style.width = playerPercent + "%";
    document.getElementById("cpBarFill").style.width = cpPercent + "%";

    // 手数表示
    document.getElementById("currentMoveNumText").textContent = `${currentData.move}手目 ${currentData.notation}`;

    // グラフ更新
    renderGraph();
  }

  // SVG形勢推移グラフ描画
  function renderGraph() {
    const totalMoves = sampleMatchHistory.length;
    const width = 460;
    const height = 60;
    const zeroY = height / 2; // y=30が互角

    // 最大振れ幅を±1500で正規化
    const maxRange = 1500;

    let pathD = "";
    let currentX = 0;
    let currentY = zeroY;

    sampleMatchHistory.forEach((item, index) => {
      const x = (index / (totalMoves - 1)) * (width - 20) + 10;
      // y座標: 上が先手有利(+), 下が後手有利(-)
      const clampedEval = Math.max(-maxRange, Math.min(maxRange, item.eval));
      const y = zeroY - (clampedEval / maxRange) * (height / 2 - 6);

      if (index === 0) {
        pathD += `M ${x} ${y}`;
      } else {
        pathD += ` L ${x} ${y}`;
      }

      if (index === currentMoveIndex) {
        currentX = x;
        currentY = y;
      }
    });

    document.getElementById("graphPath").setAttribute("d", pathD);
    const pointEl = document.getElementById("currentMovePoint");
    pointEl.setAttribute("cx", currentX);
    pointEl.setAttribute("cy", currentY);
  }

  // 棋譜送り・巻き戻し操作
  document.getElementById("btnFirst").addEventListener("click", () => {
    currentMoveIndex = 0;
    updateEvaluationUI();
  });
  document.getElementById("btnPrev").addEventListener("click", () => {
    if (currentMoveIndex > 0) {
      currentMoveIndex--;
      updateEvaluationUI();
    }
  });
  document.getElementById("btnNext").addEventListener("click", () => {
    if (currentMoveIndex < sampleMatchHistory.length - 1) {
      currentMoveIndex++;
      updateEvaluationUI();
    }
  });
  document.getElementById("btnLast").addEventListener("click", () => {
    currentMoveIndex = sampleMatchHistory.length - 1;
    updateEvaluationUI();
  });
  document.getElementById("btnLive").addEventListener("click", () => {
    currentMoveIndex = sampleMatchHistory.length - 1;
    updateEvaluationUI();
  });

  // モーダル操作
  const modal = document.getElementById("levelModal");
  document.getElementById("openLevelModalBtn").addEventListener("click", () => {
    modal.classList.add("active");
  });
  document.getElementById("closeLevelModalBtn").addEventListener("click", () => {
    modal.classList.remove("active");
  });
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.classList.remove("active");
  });

  // レベル選択処理
  document.querySelectorAll(".level-item").forEach(item => {
    item.addEventListener("click", () => {
      document.querySelectorAll(".level-item").forEach(i => i.classList.remove("active"));
      item.classList.add("active");

      const levelName = item.dataset.name;
      const levelRank = item.dataset.rank;
      const levelDesc = item.dataset.desc;

      document.getElementById("openLevelModalBtn").querySelector("span").textContent = `Lv.${item.dataset.level} ${levelName}`;
      document.getElementById("cpName").textContent = `AI棋神・${levelName}`;
      document.getElementById("cpRank").textContent = levelRank;
      document.getElementById("cpSpecDesc").textContent = levelDesc;

      modal.classList.remove("active");
    });
  });

  // 補助ボタンのアクションシミュレーション
  document.getElementById("btnKishin").addEventListener("click", () => {
    alert("⚡【棋神解析発動】\n最善手: ▲３七桂（評価値 +320 継続）\n読み筋: ▲３七桂 △４五歩 ▲同　歩 △同　桂 ▲同　桂");
  });
  document.getElementById("btnDeepAnalysis").addEventListener("click", () => {
    alert("🔍【精密解析モード】\n候補手上位3手:\n1位: ▲３七桂 (+320, 期待勝率 62.1%)\n2位: ▲２五飛 (+210, 期待勝率 58.3%)\n3位: ▲６五歩 (+165, 期待勝率 56.4%)");
  });
  document.getElementById("btnEditBoard").addEventListener("click", () => {
    alert("✏️【局面編集モード】\n駒の再配置や詰将棋・指定局面からの研究が可能です。");
  });

  // 初期化実行
  renderBoard();
  updateEvaluationUI();
</script>
</body>
</html>
